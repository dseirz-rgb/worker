# Paperless-ngx 环境变量配置
# 复制此文件为 .env.paperless 并修改配置

# 数据库密码 (生产环境请使用强密码)
PAPERLESS_DB_PASSWORD=paperless_secret

# 安全密钥 (生产环境必须修改为随机字符串)
# 生成方式: openssl rand -hex 32
PAPERLESS_SECRET_KEY=change-me-in-production-use-random-string

# 服务端口
PAPERLESS_PORT=8000

# 时区
PAPERLESS_TIME_ZONE=Asia/Shanghai

# OCR 语言 (chi_sim=简体中文, eng=英文)
PAPERLESS_OCR_LANGUAGE=chi_sim+eng

# 管理员账户 (首次启动时创建)
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=admin

# 服务 URL (用于生成文档链接)
PAPERLESS_URL=http://localhost:8000

# 性能配置
PAPERLESS_TASK_WORKERS=2
PAPERLESS_THREADS_PER_WORKER=1

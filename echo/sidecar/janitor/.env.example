# Echo Janitor 配置
# 基于 LlamaFS，使用 Groq (云端) + Ollama (图片) 混合方案

# Groq API Key (免费，获取: https://console.groq.com/)
# 或使用 Deno 中转服务
GROQ_API_KEY=your_groq_api_key_here

# OpenAI 兼容 API 配置 (可选，用于 Deno 中转)
# 如果设置了 OPENAI_BASE_URL，将使用 OpenAI 兼容模式而非 Groq 原生 API
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Ollama 配置 (本地图片理解，可选)
# OLLAMA_HOST=http://localhost:11434
AGENTOPS_API_KEY=

# Echo 分类配置
ECHO_CATEGORIES_PATH=config/echo_categories.yaml
CONFIDENCE_THRESHOLD=0.6

# SeekDB 自动索引配置
# 整理完成后自动将文件索引到 SeekDB
SEEKDB_API_URL=http://localhost:8765
SEEKDB_AUTO_INDEX=true

# Dependencies
node_modules/
.pnpm-store/

# Environment files
.env
.env.local
.env.*.local

# MCP settings (contains API keys)
**/mcp.json
!**/mcp.json.example

# Jupyter notebooks (may contain API keys)
*.ipynb

# Build outputs
dist/
build/
.next/
out/

# IDE
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache
.cache/
.turbo/
tiktoken_cache/

# Third-party source code (reference only, not our code)
get/khoj-main/

# Rust/Tauri build artifacts (very large)
**/target/
**/*.a
**/*.rlib
**/*.rmeta

# Large binary files
*.zip
*.tar.gz

# Vite cache (regenerated on build)
**/.vite/

# Prisma generated client (regenerated on build)
**/.prisma/

# node_modules in subprojects (should use package-lock.json to restore)
get/blinko-main/node_modules/
get/blinko-main/app/node_modules/
get/blinko-main/server/node_modules/

# Turbo cache
**/.turbo/

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.venv/
venv/
ENV/

# Database
*.sqlite
*.sqlite3
*.db

# Temporary files
tmp/
temp/
*.tmp

# BFG cleanup reports
..bfg-report/

# Tauri iOS generated files (regenerated by `tauri ios init`)
get/blinko-main/src-tauri/gen/
get/blinko-main/app/src-tauri/gen/

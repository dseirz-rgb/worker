# Dependencies
node_modules/
.pnpm-store/

# Environment files
.env
.env.local
.env.*.local

# MCP settings (contains API keys)
**/mcp.json
!**/mcp.json.example

# Jupyter notebooks (may contain API keys)
*.ipynb

# Build outputs
dist/
build/
.next/
out/

# IDE
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache
.cache/
.turbo/
tiktoken_cache/

# Vendor directory (external dependencies, not our code)
vendor/

# Secrets reference (contains API key hints)
.kiro/steering/secrets-reference.md

# RiskControl (independent repo, already migrated to packages/shared)
riskcontrol/

# Rust/Tauri build artifacts (very large)
**/target/
**/*.a
**/*.rlib
**/*.rmeta

# Large binary files
*.zip
*.tar.gz

# Vite cache (regenerated on build)
**/.vite/

# Prisma generated client (regenerated on build)
**/.prisma/

# node_modules in subprojects (should use package-lock.json to restore)
**/node_modules/

# Turbo cache
**/.turbo/

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.venv/
venv/
ENV/

# Database
*.sqlite
*.sqlite3
*.db

# Temporary files
tmp/
temp/
*.tmp

# BFG cleanup reports
..bfg-report/

# Tauri generated files (regenerated by build)
**/src-tauri/gen/

# Janitor data files (local data, not source code)
services/janitor/data/
services/janitor/storage/
services/janitor/seekdb_data/

# Vendor kiro configs (not our configs)
vendor/.kiro/
services/echo-server/.blinko/

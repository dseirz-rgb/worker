<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.echoai.backup</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd ~/worker &amp;&amp; ./scripts/backup-databases.sh >> ~/Backups/echoai-db/backup.log 2>&amp;1</string>
    </array>
    
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    
    <key>StandardOutPath</key>
    <string>/tmp/echoai-backup.log</string>
    
    <key>StandardErrorPath</key>
    <string>/tmp/echoai-backup-error.log</string>
    
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>

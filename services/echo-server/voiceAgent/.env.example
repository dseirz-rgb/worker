# LiveKit Voice Agent 环境变量配置
# 复制此文件为 .env 并填入实际值

# ============================================
# LiveKit 服务器配置
# ============================================

# LiveKit 服务器 WebSocket URL
# 本地开发: ws://localhost:7880
# 生产环境: wss://your-livekit-server.com
LIVEKIT_URL=ws://localhost:7880

# LiveKit API 密钥
# 从 LiveKit Cloud 控制台或自托管服务器获取
LIVEKIT_API_KEY=devkey

# LiveKit API Secret
# 与 API Key 配对使用
LIVEKIT_API_SECRET=secret

# ============================================
# Google AI 配置
# ============================================

# Google API 密钥
# 从 Google AI Studio 获取: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key

# ============================================
# 可选配置
# ============================================

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Agent 名称
# AGENT_NAME=VoiceAssistant

{
  "mcpServers": {
    "ui-tars": {
      "command": "node",
      "args": ["./dist/index.js"],
      "env": {
        "UITARS_VLM_BASE_URL": "https://api.openai.com/v1",
        "UITARS_API_KEY": "sk-your-api-key-here",
        "UITARS_MODEL": "gpt-4-vision-preview",
        "UITARS_MAX_LOOP_COUNT": "50",
        "UITARS_TIMEOUT": "60000",
        "UITARS_LOG_LEVEL": "info"
      },
      "disabled": false,
      "autoApprove": [
        "screenshot",
        "screen_info",
        "window_list"
      ]
    }
  }
}

# Cloud Build 忽略文件
# 基于 .dockerignore，排除不需要上传的大文件

# Rust/Tauri 编译缓存 (6GB+)
**/target/
app/src-tauri/target/

# Node modules (会在构建时重新安装)
node_modules/
**/node_modules/

# Git
.git/
.github/

# 构建输出
dist/
**/dist/
build/
**/build/
.turbo/
**/.turbo/
.next/
**/.next/
.cache/
**/.cache/

# 日志和临时文件
*.log
logs/
**/logs/
tmp/
**/tmp/

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
**/.DS_Store
**/._*

# 测试
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/
tests/
**/tests/
__tests__/
**/__tests__/

# 文档 (不需要部署)
*.md
!README.md
docs/

# Tauri 桌面端相关 (Cloud Run 不需要)
src-tauri/
app/src-tauri/
*.dmg
*.exe
*.msi
*.app

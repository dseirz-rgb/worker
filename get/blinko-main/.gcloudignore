# Cloud Build 忽略文件
# 基于 .dockerignore，排除不需要上传的大文件
#
# 重要：确保此文件在项目根目录

# 首先包含 .gitignore 的规则
#!include:.gitignore

# Node modules (会在构建时重新安装) - 最重要！
node_modules
node_modules/
**/node_modules
**/node_modules/
/node_modules
/node_modules/
app/node_modules
app/node_modules/

# Rust/Tauri 编译缓存 (6GB+) - 最重要！
target
target/
**/target
**/target/
src-tauri
src-tauri/
app/src-tauri
app/src-tauri/
**/src-tauri
**/src-tauri/

# Git
.git/
.github/

# 构建输出
dist/
**/dist/
build/
**/build/
.turbo/
**/.turbo/
.next/
**/.next/
.cache/
**/.cache/

# 日志和临时文件
*.log
logs/
**/logs/
tmp/
**/tmp/

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
**/.DS_Store
**/._*

# 测试
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/
tests/
**/tests/
__tests__/
**/__tests__/

# 文档 (不需要部署)
*.md
!README.md
docs/

# Tauri 桌面端相关 (Cloud Run 不需要)
src-tauri/
app/src-tauri/
*.dmg
*.exe
*.msi
*.app


# pnpm store
.pnpm-store/
**/.pnpm-store/

# Blinko 特定大文件
blinko-main/
blinko-main.zip
khoj-main/

# 本地数据
data/
**/data/
uploads/
**/uploads/

# 环境文件
.env
.env.local
.env.*.local

# 锁文件 (会重新生成)
pnpm-lock.yaml
package-lock.json
yarn.lock

# =============================================================================
# Vercel Environment Variables Template
# =============================================================================
# 
# 这些环境变量需要在 Vercel Dashboard 中配置：
# Project Settings → Environment Variables
#
# 架构说明：
# - 前端 + API: Vercel (client/ + api/)
# - LightRAG 服务: Cloud Run (lightrag-service)
# - Voice 服务: Cloud Run (voice-service)
# =============================================================================

# =============================================================================
# 必需配置 (Required)
# =============================================================================

# Supabase 数据库配置
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Gemini API (用于 AI 对话和分析)
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# Cloud Run 外部服务 URL (Required for full functionality)
# =============================================================================

# LightRAG 服务 URL (Cloud Run 或 Zeabur)
# 示例: https://lightrag-service-xxxxx-uc.a.run.app
# 或: https://provip.zeabur.app
VITE_LIGHTRAG_SERVICE_URL=https://your-lightrag-service.run.app

# Voice 服务 URL (Cloud Run)
# 示例: https://voice-service-xxxxx-uc.a.run.app
VITE_VOICE_SERVICE_URL=https://your-voice-service.run.app

# =============================================================================
# 邮件服务 (Optional - 用于风险警报邮件)
# =============================================================================

# Resend API Key
RESEND_API_KEY=your_resend_api_key_here
RISK_EMAIL_TO=your_email@example.com

# =============================================================================
# IBKR 数据同步 (Optional - 用于盈透证券数据)
# =============================================================================

# IBKR Flex Query 配置
IBKR_TOKEN=your_ibkr_token_here
IBKR_QUERY_ID=your_query_id_here

# Cloudflare Workers CORS 代理 (推荐)
VITE_CORS_PROXY_URL=https://ibkr-proxy.your-subdomain.workers.dev

# =============================================================================
# Multi-Agent 系统配置 (Optional)
# =============================================================================

# 是否启用多 Agent 系统
VITE_USE_MULTI_AGENT=true

# 编排模式: sequential | selector | handoff | respond_directly
VITE_ORCHESTRATION_MODE=sequential

# Serper API Key (新闻搜索)
VITE_SERPER_API_KEY=your_serper_api_key_here

# Jina API Key (网页内容提取)
VITE_JINA_API_KEY=your_jina_api_key_here

# =============================================================================
# 风险警报阈值 (Optional)
# =============================================================================

VITE_ALERT_DRAWDOWN_THRESHOLD=15
VITE_ALERT_LEVERAGE_THRESHOLD=2.5
VITE_ALERT_SENTIMENT_THRESHOLD=-0.5

# =============================================================================
# 扩展思考配置 (Optional)
# =============================================================================

VITE_EXTENDED_THINKING_ENABLED=true
VITE_EXTENDED_THINKING_BUDGET_TOKENS=1024

# =============================================================================
# Agent 记忆配置 (Optional)
# =============================================================================

VITE_AGENT_MEMORY_ENABLED=true
VITE_AGENT_MEMORY_MAX_ENTRIES=100

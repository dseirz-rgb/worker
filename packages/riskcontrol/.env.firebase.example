# Firebase Hosting Environment Variables
# Copy this to .env.production for Firebase deployment

# Supabase (same as before)
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Voice Service (Cloud Run URL)
VITE_VOICE_SERVICE_URL=https://voice-service-xxxxx-uc.a.run.app

# API Service (proxied through Firebase Hosting)
# When using Firebase Hosting rewrites, API calls go to /api/*
# which are proxied to Cloud Run, so no separate URL needed
# VITE_API_URL=https://api-service-xxxxx-uc.a.run.app

# LightRAG Service (Cloud Run URL, for direct client access if needed)
# VITE_LIGHTRAG_URL=https://lightrag-service-xxxxx-uc.a.run.app

# Multi-Agent System
VITE_USE_MULTI_AGENT=true
VITE_ORCHESTRATION_MODE=sequential

# Serper API Key (for news search)
VITE_SERPER_API_KEY=your_serper_api_key_here

# Jina API Key (for web content extraction)
VITE_JINA_API_KEY=your_jina_api_key_here

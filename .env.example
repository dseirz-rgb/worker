# Echo 统一配置文件
# 复制此文件为 .env 并填写配置

# ============ 认证配置 (个人使用) ============
# 是否启用 OAuth2 第三方登录 (个人使用建议关闭)
ENABLE_OAUTH=false

# 是否启用 2FA 二次验证 (云端暴露时建议开启)
ENABLE_2FA=false

# ============ 必填配置 ============

# Groq API Key (免费获取: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# ============ 服务 URL 配置 ============

# Khoj AI 服务地址 (默认: http://localhost:42110)
KHOJ_API_URL=http://localhost:42110

# Janitor 文件整理服务地址 (默认: http://localhost:8766)
JANITOR_API_URL=http://localhost:8766

# Paperless 文档管理服务地址 (默认: http://localhost:8000)
PAPERLESS_API_URL=http://localhost:8000

# Paperless API Token (必须配置才能启用 Paperless)
PAPERLESS_API_TOKEN=

# ============ 可选配置 ============

# PostgreSQL 密码 (主数据库)
POSTGRES_PASSWORD=mysecretpassword

# NextAuth 密钥 (生产环境请修改)
NEXTAUTH_SECRET=my_ultra_secure_nextauth_secret

# 待整理文件目录 (Janitor 监控的目录)
INBOX_PATH=./inbox

# Ollama 服务地址 (用于生成 embedding)
OLLAMA_HOST=http://localhost:11434

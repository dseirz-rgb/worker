# =============================================================================
# Echo + RiskControl 统一配置文件 v5.0
# =============================================================================
# 复制此文件为 .env 并填写配置
# 
# 架构说明：
# - Echo: 个人知识管理系统（笔记、任务、日常助手）
# - RiskControl: 投资风控系统（持仓、风险监控、投资顾问）
# - 两个系统共享基础设施，但数据完全隔离
# =============================================================================

# =============================================================================
# 共享配置 (Shared Configuration)
# =============================================================================
# 以下配置被 Echo 和 RiskControl 两个模块共同使用

# -----------------------------------------------------------------------------
# Supabase 认证配置 (统一认证源)
# -----------------------------------------------------------------------------
# 使用 RiskControl 的 Supabase 实例作为主认证源
# 获取地址: https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# -----------------------------------------------------------------------------
# LiveKit 语音服务配置 (双 Agent 共享)
# -----------------------------------------------------------------------------
# 用于 Investment Agent 和 Daily Agent 的语音交互
# 获取地址: https://livekit.io
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# 前端 LiveKit 配置
VITE_LIVEKIT_URL=wss://your-livekit-server.livekit.cloud

# -----------------------------------------------------------------------------
# Gemini API 配置 (AI 服务)
# -----------------------------------------------------------------------------
# 用于 Voice Service、LightRAG 和投资分析
# 获取地址: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# -----------------------------------------------------------------------------
# NextAuth 配置
# -----------------------------------------------------------------------------
# 生产环境请使用强随机密钥
NEXTAUTH_SECRET=my_ultra_secure_nextauth_secret

# =============================================================================
# Echo 模块配置 (知识管理系统)
# =============================================================================
# 笔记、任务、日历、日常助手相关配置

# -----------------------------------------------------------------------------
# Echo 数据库配置
# -----------------------------------------------------------------------------
# Echo 使用独立的 PostgreSQL 实例存储笔记和任务
POSTGRES_PASSWORD=mysecretpassword
# DATABASE_URL=postgresql://postgres:password@localhost:5432/echo

# -----------------------------------------------------------------------------
# Groq API 配置 (Janitor AI 文件整理)
# -----------------------------------------------------------------------------
# 免费获取: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# 待整理文件目录 (Janitor 监控的目录)
INBOX_PATH=./inbox

# -----------------------------------------------------------------------------
# Ollama 配置 (本地 embedding 生成)
# -----------------------------------------------------------------------------
# OLLAMA_HOST=http://localhost:11434

# -----------------------------------------------------------------------------
# Echo 认证选项
# -----------------------------------------------------------------------------
# 是否启用 OAuth2 第三方登录 (个人使用建议关闭)
ENABLE_OAUTH=false

# 是否启用 2FA 二次验证 (云端暴露时建议开启)
ENABLE_2FA=false

# =============================================================================
# RiskControl 模块配置 (投资风控系统)
# =============================================================================
# 持仓管理、风险监控、投资顾问相关配置

# -----------------------------------------------------------------------------
# RiskControl 数据库配置 (独立 Supabase 实例)
# -----------------------------------------------------------------------------
# 存储持仓、交易、风险指标等财务敏感数据
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# IBKR (Interactive Brokers) 配置
# -----------------------------------------------------------------------------
# Flex Query 用于同步持仓和交易数据
IBKR_TOKEN=your_ibkr_token_here
IBKR_QUERY_ID=your_query_id_here

# -----------------------------------------------------------------------------
# 邮件服务配置 (Resend)
# -----------------------------------------------------------------------------
# 用于发送每日风险报告和警报邮件
# 获取地址: https://resend.com
RESEND_API_KEY=your_resend_api_key_here
RISK_EMAIL_TO=your_email@example.com

# -----------------------------------------------------------------------------
# CORS 代理配置 (Cloudflare Workers)
# -----------------------------------------------------------------------------
# 用于绕过 IBKR API 的 CORS 限制
# 部署 cloudflare-worker-cors-proxy.js 后填写 Worker URL
VITE_CORS_PROXY_URL=https://ibkr-proxy.your-subdomain.workers.dev

# -----------------------------------------------------------------------------
# 数据服务配置
# -----------------------------------------------------------------------------
# OpenBB Data Service
# 本地开发: http://localhost:6900
# 生产环境: 部署后的 URL
VITE_OPENBB_API_URL=http://localhost:6900

# Qlib Analytics Service
# 本地开发: http://localhost:6901
# GCP Cloud Run: https://qlib-service-xxxxx-uc.a.run.app
VITE_QLIB_API_URL=http://localhost:6901

# 是否使用模拟数据（当 Qlib 服务不可用时）
VITE_USE_MOCK_QLIB=true

# -----------------------------------------------------------------------------
# Voice Service 配置
# -----------------------------------------------------------------------------
# 本地开发:
VITE_VOICE_SERVICE_URL=http://localhost:8080
# Cloud Run 部署:
# VITE_VOICE_SERVICE_URL=https://voice-service-xxxxx-uc.a.run.app

# -----------------------------------------------------------------------------
# Google Drive 同步配置 (知识库自动同步)
# -----------------------------------------------------------------------------
# 用于自动同步 Google Drive 中的书籍和文档到投资知识库
# 
# Service Account 认证 (推荐)
# 1. 在 GCP Console 创建 Service Account
# 2. 下载 JSON 密钥文件
# 3. 将 JSON 内容 Base64 编码后填入 GOOGLE_SERVICE_ACCOUNT_KEY
# 或者直接填写 JSON 文件路径到 GOOGLE_SERVICE_ACCOUNT_KEY_FILE
#
# 获取地址: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SERVICE_ACCOUNT_KEY=base64_encoded_service_account_json
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/path/to/service-account.json

# 要同步的 Google Drive 文件夹 ID
# 从文件夹 URL 获取: https://drive.google.com/drive/folders/{FOLDER_ID}
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# 同步间隔（分钟），默认 5 分钟
GOOGLE_DRIVE_SYNC_INTERVAL=5

# 是否启用 Google Drive 同步
GOOGLE_DRIVE_SYNC_ENABLED=true

# -----------------------------------------------------------------------------
# LightRAG 配置 (投资知识库)
# -----------------------------------------------------------------------------
# GCP Cloud Run 部署的 LightRAG 服务
LIGHTRAG_SERVICE_URL=https://lightrag-service-dpbimyzyja-uc.a.run.app
LIGHTRAG_LLM_MODEL=gemini-2.0-flash
LIGHTRAG_EMBEDDING_MODEL=models/text-embedding-004

# -----------------------------------------------------------------------------
# Quant Service 配置
# -----------------------------------------------------------------------------
QUANT_SERVICE_URL=https://quant-service-dpbimyzyja-uc.a.run.app

# -----------------------------------------------------------------------------
# 多 Agent 投资分析系统
# -----------------------------------------------------------------------------
# 是否启用多 Agent 系统 (true/false)
# 设为 false 将回退到旧版单 API 调用
VITE_USE_MULTI_AGENT=true

# 编排模式 (sequential/selector/handoff/respond_directly)
# - sequential: 按顺序执行所有 Agent
# - selector: LLM 动态选择下一个 Agent
# - handoff: Agent 之间显式交接控制
# - respond_directly: 简单查询直接由 Advisor 回答
VITE_ORCHESTRATION_MODE=sequential

# -----------------------------------------------------------------------------
# 外部数据源 API Keys
# -----------------------------------------------------------------------------
# Serper API (新闻搜索)
# 获取地址: https://serper.dev/
VITE_SERPER_API_KEY=your_serper_api_key_here

# Jina API (网页内容提取)
# 获取地址: https://jina.ai/
VITE_JINA_API_KEY=your_jina_api_key_here

# SEC API (SEC 文件查询，可选)
# 获取地址: https://sec-api.io/
VITE_SEC_API_KEY=

# -----------------------------------------------------------------------------
# 风险警报阈值配置
# -----------------------------------------------------------------------------
# 回撤警报阈值 (百分比)
VITE_ALERT_DRAWDOWN_THRESHOLD=15

# 杠杆警报阈值 (倍数)
VITE_ALERT_LEVERAGE_THRESHOLD=2.5

# 负面情绪警报阈值 (-1 到 1)
VITE_ALERT_SENTIMENT_THRESHOLD=-0.5

# -----------------------------------------------------------------------------
# AI 扩展思考配置
# -----------------------------------------------------------------------------
# 是否启用扩展思考模式
VITE_EXTENDED_THINKING_ENABLED=true

# 扩展思考 Token 预算
VITE_EXTENDED_THINKING_BUDGET_TOKENS=1024

# -----------------------------------------------------------------------------
# Agent 记忆配置
# -----------------------------------------------------------------------------
# 是否启用 Agent 长期记忆
VITE_AGENT_MEMORY_ENABLED=true

# 最大记忆条目数
VITE_AGENT_MEMORY_MAX_ENTRIES=100

# =============================================================================
# 云端部署配置 (可选)
# =============================================================================
# 以下配置用于 Vercel + GCP Cloud Run + Supabase 云端部署

# -----------------------------------------------------------------------------
# GCP Cloud Run 配置
# -----------------------------------------------------------------------------
# GCP_PROJECT_ID=your-gcp-project
# GCP_REGION=asia-east1
# CLOUD_RUN_SERVICE=echo-backend

# -----------------------------------------------------------------------------
# Vercel 配置
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://your-backend.run.app

# =============================================================================
# 环境变量说明
# =============================================================================
# 
# 变量分类：
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ 类型          │ 前缀        │ 说明                                      │
# ├─────────────────────────────────────────────────────────────────────────┤
# │ 共享配置      │ 无/VITE_    │ 两个模块共同使用                          │
# │ Echo 专用     │ 无          │ 仅 Echo 模块使用                          │
# │ RiskControl   │ VITE_       │ 仅 RiskControl 模块使用                   │
# │ 服务端       │ 无 VITE_    │ 仅服务端可访问（敏感信息）                │
# │ 客户端       │ VITE_       │ 客户端可访问（公开信息）                  │
# └─────────────────────────────────────────────────────────────────────────┘
#
# 必填变量（最小可用配置）：
# - SUPABASE_URL, SUPABASE_ANON_KEY (认证)
# - VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY (RiskControl 数据)
# - GEMINI_API_KEY (AI 功能)
# - LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET (语音功能)
#
# 可选但推荐：
# - IBKR_TOKEN, IBKR_QUERY_ID (自动同步持仓)
# - RESEND_API_KEY (邮件报告)
# - VITE_SERPER_API_KEY, VITE_JINA_API_KEY (新闻搜索)
# =============================================================================

# Echo 统一配置文件 v4.0
# 复制此文件为 .env 并填写配置

# ============================================================
# 本地开发配置
# ============================================================

# PostgreSQL 密码
POSTGRES_PASSWORD=mysecretpassword

# Groq API Key (免费获取: https://console.groq.com/)
# 用于 Janitor AI 文件整理
GROQ_API_KEY=your_groq_api_key_here

# 待整理文件目录 (Janitor 监控的目录)
INBOX_PATH=./inbox

# NextAuth 密钥 (生产环境请修改)
NEXTAUTH_SECRET=my_ultra_secure_nextauth_secret

# ============================================================
# 云端部署配置 (Vercel + Cloud Run + Supabase)
# ============================================================

# Supabase 配置 (https://supabase.com)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_KEY=your_service_key
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# GCP Cloud Run 配置
# GCP_PROJECT_ID=your-gcp-project
# GCP_REGION=asia-east1
# CLOUD_RUN_SERVICE=echo-backend

# Vercel 配置
# NEXT_PUBLIC_API_URL=https://your-backend.run.app

# ============================================================
# 可选配置
# ============================================================

# Ollama 服务地址 (本地 embedding 生成)
# OLLAMA_HOST=http://localhost:11434

# 是否启用 OAuth2 第三方登录 (个人使用建议关闭)
ENABLE_OAUTH=false

# 是否启用 2FA 二次验证 (云端暴露时建议开启)
ENABLE_2FA=false
